{
  "manifest_version": 3,
  "name": "Element451 Dedup Tools",
  "version": "1.0.7",
  "description": "Scoring, a plain-English write-up and optional auto-merge for the Element451 Deduplication review queue.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Element451 Dedup Tools",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.element451.io/*"]
}
